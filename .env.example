# DeyeCloud Developer API Configuration
# Obtain App ID and App Secret from https://developer.deyecloud.com/
DEYE_BASE_URL=https://india-developer.deyecloud.com
DEYE_APP_ID=your_deye_app_id
DEYE_APP_SECRET=your_deye_app_secret
DEYE_EMAIL=your_deye_email
DEYE_PASSWORD=your_deye_password

# Comma-separated list of configured microinverter serial numbers
DEYE_DEVICE_SNS=260605A076,260603A1D5,260505A373

# Optional: Company ID if using a business/enterprise DeyeCloud account
DEYE_COMPANY_ID=0

# Supabase Collector Configuration (for local testing; use GitHub Secrets in production)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Collector / Backend settings
COLLECTION_INTERVAL_MINUTES=30
API_TIMEOUT_SECONDS=20
LOG_LEVEL=INFO
